<h1>All Orders</h1>
<table>
    <thead>
        <tr>
            <th>Order Id</th>
            <th>Customer</th>
            <th>Data</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        {{#each ordersList}}
        <tr>
            <td>{{orderId}}</td>
            <td>{{customerName}}</td>
            <td>{{orderDate}}</td>
            <td class="{{status}}">{{status}}</td>
            <td><a href="/update-status?order={{orderId}}">Update Status</a></td>
        </tr>
        {{/each}}
    </tbody>
</table>
